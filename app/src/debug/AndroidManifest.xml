<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          Debug builds only: drive the bells over adb until the bells screen exists (Phase 8).
          DUMP is held by the adb shell, and can't be granted to other apps.
        -->
        <receiver
            android:name=".bells.BellDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
